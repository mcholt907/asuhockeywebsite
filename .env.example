# Environment Variables Template
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (update for production)
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000

# Production origin used in the sitemap (server.js) and prerendered HTML
# (scripts/prerender.js). Defaults to https://forksuppucks.com if unset.
# SITE_BASE_URL=https://forksuppucks.com

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Production Settings (uncomment for production)
# NODE_ENV=production
# PORT=5000
# FRONTEND_URL=https://yourdomain.com
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend (Vite) — exposed to the client-side bundle. Optional; only needed
# if you want browser-side Sentry error tracking from the React app.
# VITE_SENTRY_DSN=

# Scraper override flags
# Set to 'true' to force live scraping during local refresh runs.
# Production (NODE_ENV=production) and prerender (IS_PRERENDER=true)
# default to bundled fallback JSON in data/.
ALUMNI_SCRAPE_LIVE=
TRANSFER_SCRAPE_LIVE=

# Set to 'true' to enable the Puppeteer fallback when a request gets a 403.
# Defaults to off — on cloud-hosted infra (Render) the fallback hits the same
# blocked IP, so it adds latency without rescuing anything. Local dev with
# residential IP can set this to true if useful.
SCRAPER_PUPPETEER_FALLBACK=

# Sentry check-ins automatically configure the daily runner monitor
# (06:00 America/Phoenix; 12-hour missed-run grace). The runner also accepts
# the existing REACT_APP_SENTRY_DSN used by the backend.
# Set the same DSN as repository Actions secret SENTRY_DSN for the independent
# hourly production freshness check. Verify notification recipients in Sentry.
# SENTRY_DSN=
# Legacy provider-issued HTTP check-in URL, used only when no DSN is set:
# SENTRY_CRON_MONITOR_URL=
